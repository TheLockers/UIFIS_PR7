<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>


		<!-- добавлено-->
		<AnalysisLevel>latest</AnalysisLevel>							<!--Задает уровень анализатора в коде-->
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>			<!--включает проверку правил оформления кода при сборке-->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>		<!--включает генерацию XML-файла документации для проекта-->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>				<!--Все предупреждения теперь ошибки!-->
	</PropertyGroup>

	<ItemGroup>
		<EditorConfigFiles Remove="C:\Users\polun\source\repos\UIFIS_PR7\UIFIS_PR7\.editorconfig" />
	</ItemGroup>

	<ItemGroup>
		<None Include="C:\Users\polun\source\repos\UIFIS_PR7\UIFIS_PR7\.editorconfig" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="StyleCop.Analyzers" Version="1.3.180">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>

</Project>
